<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- SysRecover CLI 应用程序清单：唯一目的 = 启动即请求管理员权限。

     与 GUI 的 SysRecoverUI.manifest 同法（见 AGENTS.md PIT-018），
     刻意【不】声明 dpiAware / Common-Controls —— 本程序是 -mconsole
     控制台程序，没有自绘控件以外的 GUI 元素，多加只会平白改变行为。

     关于「机房批量 / 静默执行」（本清单的实际动机）：
       - 以管理员身份运行（管理员命令行、计划任务勾选"最高权限"、PsExec -s、
         SCCM/域推送）时，进程已是高完整性 → **不弹 UAC，全程静默** ✅
       - 仅当从**普通用户**命令行/双击启动时，Windows 才弹一次 UAC。这是操作
         系统的安全边界，任何提权途径（含 ShellExecuteW runas 自提升）都一样
         会弹，程序侧无法绕过。
       - 本清单是 **asInvoker + 运行期按需提权**（见下方 requestedExecutionLevel）。
         需要管理员的命令由程序自己 ShellExecuteExW(runas) 重新拉起自己，
         因此会**重启一个进程**（原注释"单进程、不重启"已过时，M13 修正）：
         参数会原样搬运；工作目录由 lpDirectory 显式传入（否则新进程落到
         System32，相对路径全错）；退出码由父进程等待子进程后透传。 -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="SysRecover.CLI" version="0.1.0.0" processorArchitecture="*"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!-- PIT-200（2026-11-01 用户规格）：CLI 改 asInvoker + **运行期按需提权**。
         原 requireAdministrator 在"UAC 关闭 / PE / 非交互会话"下会让进程
         直接起不来且**没有任何输出**（技术员反馈"命令行用不了、什么都不做"）。
         现在：只读命令（version/help/history/images/verify/extract）直接可用；
         需要管理员的命令由程序自己弹 UAC（ShellExecute runas）或给出明确提示。 -->
    <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <!-- M9：声明长路径支持（Win32 文件 API 才会接受 >260 字符的路径）。 -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
