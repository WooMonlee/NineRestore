<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- SysRecoverUI 应用程序清单：唯一目的 = 启动即请求管理员权限。
     备份/还原核心功能（枚举分区、写 BCD/引导、wimlib 挂载）全部需要管理员，
     因此双击 exe 时由 Windows 加载器直接弹一次 UAC（requireAdministrator）。

     刻意【不】声明其他项：
       - 不加 Common-Controls v6 依赖：本项目 GUI 全是 Duilib 自绘控件，只有
         SkinEdit 内部那个原生 EDIT 子窗口受影响，加了会平白改变它的外观。
       - 不加 dpiAware / dpiAwareness：会把界面从当前的 DPI 虚拟化切成真实
         DPI 渲染，等于顺带改了高 DPI 表现（本次需求与 DPI 无关，见
         docs/ui-design.md §6.3）。
     补充（M9）：新增 longPathAware —— 只有声明它，Win32 文件 API 才接受
     超过 260 字符的路径（配合代码里的 \\?\ 前缀），便于清理/备份深目录。 -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="SysRecover.UI" version="0.1.0.0" processorArchitecture="*"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
